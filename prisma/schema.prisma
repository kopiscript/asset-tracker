generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String      @unique
  phone          String?
  password       String
  usertype       String      @default("user")
  createdAt      DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  sentInvites    OrgInvite[]
  orgMemberships OrgMember[]

  @@map("users")
}

model Organization {
  id                  String      @id @default(cuid())
  name                String
  createdAt           DateTime    @default(now()) @map("created_at")
  plan                String      @default("free")
  planExpiresAt       DateTime?   @map("plan_expires_at")
  billplzSubId        String?     @map("billplz_sub_id")
  gracePeriodEndsAt   DateTime?   @map("grace_period_ends_at")
  nameSetAt           DateTime?   @map("name_set_at")
  onboardingSkippedAt DateTime?   @map("onboarding_skipped_at")
  invites             OrgInvite[]
  members             OrgMember[]
  vehicles            Vehicle[]

  @@map("organizations")
}

model OrgMember {
  id            String                @id @default(cuid())
  userId        String                @map("user_id") @db.Uuid
  orgId         String                @map("org_id")
  role          String
  createdAt     DateTime              @default(now()) @map("created_at")
  seenWelcomeAt DateTime?             @map("seen_welcome_at")
  org           Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleAccess ViewerVehicleAccess[]

  @@unique([userId, orgId], map: "org_members_userId_orgId_key")
  @@map("org_members")
}

model ViewerVehicleAccess {
  id        String    @id @default(cuid())
  memberId  String    @map("member_id")
  vehicleId BigInt    @map("vehicle_id")
  member    OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([memberId, vehicleId])
  @@map("viewer_vehicle_access")
}

model Vehicle {
  id               BigInt                @id @default(autoincrement())
  imei             String                @unique
  name             String?               @map("vehicle_name")
  plateNumber      String?               @map("plate_number")
  type             String?               @map("model")
  isActive         Boolean?              @default(true) @map("is_active")
  createdAt        DateTime?             @default(now()) @map("created_at") @db.Timestamp(6)
  driverName       String?               @map("driver_name")
  orgId            String?               @map("org_id")
  apiKey           String?               @map("api_key")
  telemetryRecords TelemetryRecord[]
  org              Organization?         @relation(fields: [orgId], references: [id])
  viewerAccess     ViewerVehicleAccess[]

  @@map("vehicles")
}

model TelemetryRecord {
  id                     BigInt    @id @default(autoincrement())
  vehicleId              BigInt    @map("vehicle_id")
  imei                   String
  timestampUtc           DateTime  @map("timestamp_utc") @db.Timestamp(6)
  timestampMy            DateTime  @map("timestamp_my") @db.Timestamp(6)
  latitude               Float?
  longitude              Float?
  altitude               Float?
  angle                  Float?
  speedKmh               Float?    @map("speed_kmh")
  satellites             Int?
  priority               Int?
  ignition               Int?
  movement               Int?
  gnssFixType            Int?      @map("gnss_fix_type")
  gnssStatus             Int?      @map("gnss_status")
  gsmSignal              Int?      @map("gsm_signal")
  gsmOperator            String?   @map("gsm_operator")
  networkType            Int?      @map("network_type")
  externalVoltage        Float?    @map("external_voltage")
  batteryVoltage         Float?    @map("battery_voltage")
  batteryCurrent         Float?    @map("battery_current")
  batteryPercent         Int?      @map("battery_percent")
  sleepMode              Int?      @map("sleep_mode")
  dataMode               Int?      @map("data_mode")
  crashEvent             Int?      @map("crash_event")
  bleData                Int?      @map("ble_data")
  speedAlt               Float?    @map("speed_alt")
  carState               Int?      @map("car_state")
  carBatteryVoltage      Float?    @map("car_battery_voltage")
  gnssRaw                String?   @map("gnss_raw")
  payload                Json      @default("{}")
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  event_io_id            Int?
  axis_x                 Int?
  axis_y                 Int?
  axis_z                 Int?
  fuel_used_gps          Decimal?  @db.Decimal
  dtc_count              Int?
  engine_load            Int?
  engine_coolant_temp    Int?
  short_fuel_trim        Int?
  engine_rpm             Int?
  obd_speed              Int?
  timing_advance         Int?
  intake_air_temp        Int?
  maf                    Int?
  throttle_position      Int?
  engine_runtime         Int?
  distance_mil_on        Int?
  distance_since_clear   Int?
  barometric_pressure    Int?
  control_module_voltage Decimal?  @db.Decimal
  absolute_load          Int?
  time_mil_on            Int?
  time_since_clear       Int?
  fuel_level_obd         Int?
  fault_codes            String?
  vehicle                Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([imei, timestampUtc(sort: Desc)], map: "idx_imei_time")
  @@index([vehicleId, timestampMy(sort: Desc)], map: "idx_vehicle_time_my")
  @@map("telemetry_records")
}

model OrgInvite {
  id         String       @id @default(cuid())
  email      String
  orgId      String       @map("org_id")
  role       String
  token      String       @unique
  invitedBy  String       @map("invited_by") @db.Uuid
  expiresAt  DateTime     @map("expires_at")
  acceptedAt DateTime?    @map("accepted_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  inviter    User         @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([email, orgId], map: "org_invites_email_orgId_key")
  @@map("org_invites")
}
